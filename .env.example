# ============================================================
# AutoResearch 环境变量示例
# 复制为 .env 后填入真实值；所有密钥只从环境变量读取，绝不硬编码。
# ============================================================

# ---------- LLM 提供方 ----------
# 可选值: deepseek（默认） | siliconflow
LLM_PROVIDER=deepseek

# DeepSeek 官方 API（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 硅基流动 SiliconFlow（OpenAI 兼容）
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# ---------- Tavily 搜索（国外源，可选）----------
# 未配置时 search_web 跳过该源（Tavily 与博查均未配置时返回模拟结果）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
TAVILY_MAX_RESULTS=5

# ---------- 博查搜索（国内源，可选）----------
# 与 Tavily 结果合并，覆盖国内互联网内容；key 从 open.bochaai.com 注册获取
BOCHA_API_KEY=sk-b91f944d0eb94731950773648efda2cc
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search

# ---------- 持久化 ----------
# 可选值: memory | sqlite | postgres
CHECKPOINTER=sqlite
# SQLite 检查点文件路径（CHECKPOINTER=sqlite 时使用）
CHECKPOINT_DB=./data/checkpoints.sqlite
# PostgreSQL 连接串（CHECKPOINTER=postgres 时必填）
DATABASE_URL=postgresql://autoresearch:autoresearch@localhost:5432/autoresearch

# ---------- 调研历史（历史报告/批改意见功能） ----------
# 独立的 SQLite 文件，与 checkpoint 分离（可选）
HISTORY_DB=./data/history.sqlite

# ---------- 可观测性（可选）----------
# 集成 LangSmith 追踪：置为 true 并填入 API key 后启用
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-xxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=AutoResearch
